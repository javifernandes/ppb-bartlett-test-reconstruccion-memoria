# Sin esta variable (o con "heuristic"), el análisis funciona localmente.
RECALL_ANALYSIS_PROVIDER=heuristic

# Para usar DeepSeek, cambiar el provider y completar la clave.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Carga un experimento cerrado, dos respuestas y sus análisis al iniciar.
SEED_DEMO_DATA=false

# Autenticación de administradores con Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Usar "supabase" una vez aplicada la migración; por defecto usa memoria.
DATA_GRAPH_PROVIDER=memory

# Simula el país inferido por Vercel durante el desarrollo local.
PARTICIPANT_COUNTRY_OVERRIDE=AR
