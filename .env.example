# Sin esta variable (o con "heuristic"), el análisis funciona localmente.
RECALL_ANALYSIS_PROVIDER=heuristic

# Para usar DeepSeek, cambiar el provider y completar la clave.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Carga un experimento cerrado, dos respuestas y sus análisis al iniciar.
SEED_DEMO_DATA=false
