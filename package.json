{
  "name": "ppb-bartlett-test-reconstruccion-memoria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "pnpm codegen:check && next build --webpack",
    "codegen": "ontahi-codegen",
    "codegen:check": "ontahi-codegen --check",
    "dev": "pnpm codegen && next dev --webpack",
    "dev:demo": "SEED_DEMO_DATA=true pnpm dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --no-warn-ignored",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "pnpm codegen:check && tsc --noEmit",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@mantine/core": "9.7.3",
    "@mantine/form": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@mantine/notifications": "9.7.3",
    "@ontahi/core": "1.0.0-alpha.13",
    "@ontahi/react": "1.0.0-alpha.13",
    "@ontahi/runtime-nextjs": "1.0.0-alpha.13",
    "@ontahi/supabase": "1.0.0-alpha.13",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tabler/icons-react": "3.49.0",
    "@tanstack/react-query": "5.104.5",
    "effect": "3.21.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@ontahi/codegen": "1.0.0-alpha.13",
    "@ontahi/devtools": "1.0.0-alpha.13",
    "@types/node": "24.10.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "postcss": "8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
